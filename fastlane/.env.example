# Copy to fastlane/.env (ignored by Git). Run commands from the repository root.
# Apple Developer team, NOT the App Store Connect numeric team ID.
APPLE_TEAM_ID=

# Required for each archive; use a new, increasing number for each upload.
BUILD_NUMBER=1
# Optional; if empty, use the project's marketing version.
APP_VERSION=

# Enable only after configuring an Apple Developer account in Xcode.
ALLOW_PROVISIONING_UPDATES=false

# App Store Connect TEAM API key with permission to upload this app.
# Upload only: not needed for test/build. Keep the private key outside this repo.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=/absolute/path/outside/repository/AuthKey_KEYID.p8